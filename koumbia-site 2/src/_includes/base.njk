      <div>
        <h3 class="font-display font-700 text-white text-sm tracking-wide mb-4">LIENS</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="#" class="hover:text-white transition-colors">Mentions légales</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Politique de confidentialité</a></li>
          <li><a href="https://wa.me/224613767090" class="hover:text-white transition-colors">Proposer une info</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-display font-700 text-white text-sm tracking-wide mb-4">SUIVEZ-NOUS</h3>
        <div class="flex gap-3">
          <a href="https://wa.me/224613767090" aria-label="WhatsApp" class="glass-pill w-10 h-10 rounded-full flex items-center justify-center hover:bg-laterite transition-colors">
            <svg class="icon" style="width:1.1rem;height:1.1rem"><use href="#i-whatsapp"/></svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=61582910897235" aria-label="Facebook" class="glass-pill w-10 h-10 rounded-full flex items-center justify-center hover:bg-laterite transition-colors">
