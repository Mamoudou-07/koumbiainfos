      </div>
      <div>
        <h3 class="font-display font-700 text-white text-sm tracking-wide mb-4">NAVIGATION</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/#actualites" class="hover:text-white transition-colors">Actualités</a></li>
