<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="{{ description or 'Koumbia Infos - Le journal et portail d\'information de Koumbia, Préfecture de Gaoual, Guinée.' }}">
<meta name="keywords" content="Koumbia, Guinée, Infos, Actualités, Santé, Agriculture, Développement local, Gaoual">
<meta name="author" content="KoumbiaConnect">
<meta property="og:title" content="{{ title or 'Koumbia Infos' }} — Le journal de Koumbia">
<meta property="og:description" content="{{ description or 'Les actualités et informations locales de Koumbia, en direct.' }}">
<meta property="og:type" content="website">
<title>{{ title or 'Koumbia Infos' }} — Le journal de Koumbia</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --indigo:#17233F; --indigo-dp:#0E1729; --laterite:#C1502E; --laterite-dp:#9C3D22;
    --gold:#E5A639; --green:#3B6B45; --paper:#F8F5EF; --paper-dp:#EFE9DD;
    --ink:#1D1B18; --ink-soft:#585349; --rule:#DED6C4; --ease:cubic-bezier(.16,1,.3,1);
  }
  *{scroll-behavior:smooth;}
  html{scroll-padding-top:88px;}
  body{ font-family:'Inter',system-ui,sans-serif; background:var(--paper); color:var(--ink); -webkit-font-smoothing:antialiased; }
  .font-display{font-family:'Archivo',sans-serif;}
  .text-laterite{color:var(--laterite);} .bg-laterite{background:var(--laterite);}
  .bg-indigo{background:var(--indigo);} .bg-indigo-dp{background:var(--indigo-dp);}
  .text-gold{color:var(--gold);} .bg-gold{background:var(--gold);}
  .text-ink-soft{color:var(--ink-soft);} .border-rule{border-color:var(--rule);}
  a:focus-visible, button:focus-visible, [tabindex]:focus-visible{ outline:2px solid var(--laterite); outline-offset:3px; border-radius:2px; }
  .masthead-rule{ background:repeating-linear-gradient(90deg, var(--gold) 0 22px, transparent 22px 26px); height:3px; }
  .ticker-track{ display:flex; width:max-content; animation:tick 32s linear infinite; }
  @keyframes tick{ from{transform:translateX(0);} to{transform:translateX(-50%);} }
  .ticker-item{white-space:nowrap;}
  .hero-ridge{ position:absolute; left:0; right:0; bottom:-1px; height:64px; background:var(--paper);
    clip-path:polygon(0 100%,0 40%,6% 55%,14% 30%,22% 58%,30% 20%,40% 60%,50% 15%,60% 55%,70% 25%,80% 58%,88% 35%,96% 55%,100% 30%,100% 100%); }
  .article-card{ transition:transform .35s cubic-bezier(.4,0,.2,1), box-shadow .35s cubic-bezier(.4,0,.2,1); }
  .article-card:hover{ transform:translateY(-6px); }
  .glass.article-card:hover{ box-shadow:0 1px 1px rgba(255,255,255,.8) inset, 0 -1px 8px rgba(23,35,63,.06) inset, 0 30px 50px -20px rgba(23,35,63,.32); }
  .corner-tag{ position:absolute; top:0; left:0; background:var(--laterite); color:#fff; padding:.4rem 1.1rem .4rem .9rem;
    font-family:'Archivo',sans-serif; font-weight:800; font-size:.72rem; letter-spacing:.08em; clip-path:polygon(0 0,100% 0,88% 100%,0 100%); }
  .badge-pulse{ animation:pulse 2.4s ease-in-out infinite; }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:.55;} }
  .cat-pill{ transition:background .25s ease, color .25s ease, border-color .25s ease, transform .2s ease; }
  .cat-pill:hover{ transform:translateY(-2px); }
  .icon{ width:1.15rem; height:1.15rem; stroke:currentColor; fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; display:inline-block; }
  .icon-lg{ width:1.9rem; height:1.9rem; }
  .glass{ background:linear-gradient(180deg, rgba(255,255,255,.72), rgba(255,255,255,.42)); backdrop-filter:blur(22px) saturate(180%); -webkit-backdrop-filter:blur(22px) saturate(180%);
    border:1px solid rgba(255,255,255,.65); box-shadow:0 1px 1px rgba(255,255,255,.8) inset, 0 -1px 8px rgba(23,35,63,.06) inset, 0 20px 40px -20px rgba(23,35,63,.25); }
  .glass-pill{ background:rgba(255,255,255,.14); backdrop-filter:blur(16px) saturate(160%); -webkit-backdrop-filter:blur(16px) saturate(160%);
    border:1px solid rgba(255,255,255,.28); box-shadow:0 1px 0 rgba(255,255,255,.3) inset; }
  .glass-pill.is-active{ background:rgba(255,255,255,.92); border-color:rgba(255,255,255,.9); box-shadow:0 1px 0 rgba(255,255,255,.9) inset, 0 8px 20px -10px rgba(0,0,0,.35); }
  .glass-nav{ background:rgba(248,245,239,.6); backdrop-filter:blur(24px) saturate(180%); -webkit-backdrop-filter:blur(24px) saturate(180%); }
  .glass-btn-light{ background:linear-gradient(180deg, rgba(255,255,255,.95), rgba(255,255,255,.75)); backdrop-filter:blur(16px) saturate(180%); -webkit-backdrop-filter:blur(16px) saturate(180%);
    border:1px solid rgba(255,255,255,.9); box-shadow:0 1px 0 rgba(255,255,255,1) inset, 0 10px 24px -12px rgba(0,0,0,.35); }
  .glass-btn-outline{ background:rgba(255,255,255,.08); backdrop-filter:blur(16px) saturate(160%); -webkit-backdrop-filter:blur(16px) saturate(160%); border:1px solid rgba(255,255,255,.35); box-shadow:0 1px 0 rgba(255,255,255,.25) inset; }
  .blob{ position:absolute; border-radius:9999px; filter:blur(64px); pointer-events:none; }
  @media (prefers-reduced-motion: no-preference){ .blob-float{ animation:blobFloat 14s ease-in-out infinite; } }
  @keyframes blobFloat{ 0%,100%{ transform:translate(0,0) scale(1); } 50%{ transform:translate(-16px,18px) scale(1.06); } }
  @media (prefers-reduced-motion: reduce){ *{animation-duration:.001s !important; animation-iteration-count:1 !important; transition-duration:.001s !important;} }
  ::selection{ background:var(--gold); color:var(--indigo-dp); }
  .hero-photo{ background-image:linear-gradient(180deg, rgba(14,23,41,.88), rgba(14,23,41,.94)), url('https://images.unsplash.com/photo-1636783186942-188af7eb0ef5?fm=jpg&q=70&w=2400&auto=format&fit=crop'); background-size:cover; background-position:center; }
  #mainNav{ transition:transform .5s var(--ease), box-shadow .4s ease; }
  #mainNav.nav-hidden{ transform:translateY(-100%); }
  #mainNav.nav-scrolled{ box-shadow:0 1px 28px rgba(23,35,63,.10); }
  .reveal{ opacity:0; transform:translateY(30px); transition:opacity .9s var(--ease), transform .9s var(--ease); }
  .reveal.is-visible{ opacity:1; transform:translateY(0); }
  a, button{ -webkit-tap-highlight-color:transparent; }
  .press{ transition:transform .3s var(--ease), box-shadow .3s var(--ease); }
  .press:active{ transform:scale(.96); }
  .card-media{ transition:transform .8s var(--ease); }
  .article-card:hover .card-media{ transform:scale(1.06); }
  #heroContent{ transition:opacity .1s linear; will-change:transform, opacity; }
  #articlesContainer > *:nth-child(1){ transition-delay:.05s; }
  #articlesContainer > *:nth-child(2){ transition-delay:.16s; }
  #articlesContainer > *:nth-child(3){ transition-delay:.27s; }
</style>
</head>
<body>

<nav id="mainNav" class="glass-nav sticky top-0 z-50 border-b border-white/50">
  <div class="max-w-7xl mx-auto px-5">
    <div class="flex justify-between items-center h-16">
      <a href="/" class="font-display font-900 text-2xl tracking-tight flex items-baseline gap-1">
        <span style="color:var(--indigo)">KOUMBIA</span><span class="text-laterite">INFOS</span>
      </a>
      <div id="navMenu" class="hidden md:flex items-center gap-8 font-medium text-sm">
        <a href="/#actualites" class="hover:text-laterite transition-colors">Actualités</a>
        <a href="/#categories" class="hover:text-laterite transition-colors">Catégories</a>
        <a href="/#contact" class="hover:text-laterite transition-colors">Contact</a>
        <a href="https://wa.me/224613767090" class="glass flex items-center gap-2 text-[var(--indigo)] px-4 py-2 rounded-full text-sm font-semibold hover:brightness-95 transition">
          <svg class="icon" style="width:1rem;height:1rem" viewBox="0 0 24 24"><path d="M20.5 3.5A11 11 0 0 0 3.6 17.1L2 22l5-1.6A11 11 0 1 0 20.5 3.5Z"/><path d="M8.3 8.7c.3-.9 1-.8 1.6-.8s.6.4.8.9.7 1.6.7 1.8-.1.4-.3.6-.5.5-.7.7-.4.4-.1.9a8 8 0 0 0 3.4 3.2c.5.2.7.1 1-.2s1-1.1 1.2-1.4.5-.3.9-.2 2.3 1.1 2.7 1.3.6.3.7.5-.1 1.2-.7 1.8-1.7 1.2-3 1a11 11 0 0 1-6.4-4.3c-1.6-2-2.1-3.7-2.2-4.3s0-1.5.4-1.9Z" fill="currentColor" stroke="none"/></svg>
          WhatsApp
        </a>
      </div>
      <button id="mobileMenuBtn" class="md:hidden text-2xl leading-none" aria-label="Ouvrir le menu" aria-expanded="false">
        <svg class="icon icon-lg" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
    <div id="mobileMenu" class="hidden md:hidden pb-5 flex flex-col gap-4 font-medium text-sm">
      <a href="/#actualites" class="hover:text-laterite">Actualités</a>
      <a href="/#categories" class="hover:text-laterite">Catégories</a>
      <a href="/#contact" class="hover:text-laterite">Contact</a>
      <a href="https://wa.me/224613767090" class="text-laterite font-semibold">Écrire sur WhatsApp →</a>
    </div>
  </div>
</nav>

{% if collections.articles.length %}
<div class="bg-indigo-dp text-white overflow-hidden relative">
  <div class="blob" style="width:220px;height:220px;background:var(--laterite);opacity:.28;top:-110px;left:8%;"></div>
  <div class="blob" style="width:200px;height:200px;background:var(--gold);opacity:.2;top:-110px;right:15%;"></div>
  <div class="max-w-7xl mx-auto flex items-stretch py-2 px-3 relative z-10">
    <div class="hidden sm:flex glass-pill items-center gap-2 px-4 py-1.5 rounded-full font-display font-800 text-xs tracking-wider shrink-0 z-10 mr-3">
      <span class="w-2 h-2 rounded-full bg-white badge-pulse"></span> EN DIRECT
    </div>
    <div class="glass-pill overflow-hidden py-1.5 px-4 rounded-full text-sm text-white/90 flex-1">
      <div class="ticker-track">
        {% for a in collections.articles %}<span class="ticker-item mr-10">{{ a.data.title }}</span>{% endfor %}
        {% for a in collections.articles %}<span class="ticker-item mr-10" aria-hidden="true">{{ a.data.title }}</span>{% endfor %}
      </div>
    </div>
  </div>
</div>
{% endif %}

{{ content | safe }}

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <g id="i-pin"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.2"/></g>
    <g id="i-whatsapp"><path d="M20.5 3.5A11 11 0 0 0 3.6 17.1L2 22l5-1.6A11 11 0 1 0 20.5 3.5Z"/><path d="M8.3 8.7c.3-.9 1-.8 1.6-.8s.6.4.8.9.7 1.6.7 1.8-.1.4-.3.6-.5.5-.7.7-.4.4-.1.9a8 8 0 0 0 3.4 3.2c.5.2.7.1 1-.2s1-1.1 1.2-1.4.5-.3.9-.2 2.3 1.1 2.7 1.3.6.3.7.5-.1 1.2-.7 1.8-1.7 1.2-3 1a11 11 0 0 1-6.4-4.3c-1.6-2-2.1-3.7-2.2-4.3s0-1.5.4-1.9Z" fill="currentColor" stroke="none"/></g>
    <g id="i-facebook"><path d="M15 3h-2.5A4.5 4.5 0 0 0 8 7.5V10H5.5v3.5H8V21h3.5v-7.5h2.7l.5-3.5h-3.2V7.7c0-.9.3-1.6 1.6-1.6H15V3Z" fill="currentColor" stroke="none"/></g>
    <g id="i-calendar"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></g>
    <g id="i-arrow"><path d="M5 12h14M13 6l6 6-6 6"/></g>
    <g id="i-health"><path d="M12 21s-7.5-4.9-9.5-9.9C1 7.4 3.4 4 7 4c2 0 3.6 1.1 5 3 1.4-1.9 3-3 5-3 3.6 0 6 3.4 4.5 7.1C19.5 16.1 12 21 12 21Z"/></g>
    <g id="i-shield"><path d="M12 3l7 3v6c0 5-3.2 7.7-7 9-3.8-1.3-7-4-7-9V6l7-3Z"/></g>
    <g id="i-mail"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 6 8 6 8-6"/></g>
    <g id="i-home"><path d="M4 11.5 12 4l8 7.5V20a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1v-8.5Z"/></g>
    <g id="i-chart"><path d="M4 20V10M11 20V4M18 20v-7"/><path d="M3 20h18"/></g>
    <g id="i-columns"><path d="M4 21V9l8-5 8 5v12M4 21h16M8 21v-8M12 21v-8M16 21v-8"/></g>
    <g id="i-globe"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></g>
    <g id="i-cap"><path d="M2 9 12 4l10 5-10 5-10-5Z"/><path d="M6 11.5V17c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5v-5.5"/><path d="M22 9v6"/></g>
  </defs>
</svg>

