---
layout: "base.njk"
---

<article class="max-w-4xl mx-auto px-6 py-12 md:py-16">
  <!-- Breadcrumb -->
  <div class="mb-8">
    <a href="/" class="text-blue-600 hover:text-blue-900 text-sm font-semibold">← Retour</a>
  </div>

  <!-- Article Header -->
  <div class="mb-8">
    <h1 class="text-5xl font-bold text-gray-900 mb-6 leading-tight">{{ title }}</h1>
    <div class="flex gap-8 text-sm text-gray-600 pb-8 border-b-2 border-gray-200">
      <span>📅 {{ date | dateFilter }}</span>
      <span class="text-blue-600 font-semibold">📌 {{ category }}</span>
    </div>
  </div>

  <!-- Article Content -->
  <div class="prose prose-lg max-w-none mb-12 text-gray-700 leading-relaxed">
    {{ content | safe }}
  </div>

  <!-- Back to Articles -->
  <div class="mt-12 pt-8 border-t-2 border-gray-200">
    <a href="/" class="text-blue-600 hover:text-blue-900 font-semibold">
      ← Retour aux actualités
    </a>
  </div>
</article>
